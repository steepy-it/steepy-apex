{
  "name": "steepy-apex",
  "version": "1.3.3",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "description": "A plugin for Claude Code, Codex, OpenCode, Pi, and DeepSeek Harness that keeps your project's rules in a versioned hub, checks that its links and code references still resolve, and sizes the workflow to each task.",
  "keywords": [
    "context-engineering",
    "workflows",
    "skills",
    "spec-driven-development",
    "code-review",
    "subagents",
    "autonomous-loops",
    "project-knowledge",
    "documentation-drift",
    "agents-md",
    "model-selection"
  ],
  "author": {
    "name": "steepy-it",
    "email": "info@steepy.it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/steepy-it/steepy-apex.git"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "./adapters/opencode/steepy-apex.js",
  "exports": {
    ".": "./adapters/opencode/steepy-apex.js",
    "./adapters/dsh": "./adapters/dsh/steepy-apex.js"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "extensions": [
      "./adapters/pi"
    ]
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    ".agents/",
    ".claude-plugin/",
    ".codex-plugin/",
    "adapters/",
    "assets/",
    "docs/",
    "hooks/",
    "scripts/",
    "skills/",
    "templates/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "RELEASE.md",
    "cordis.patch.yml"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
