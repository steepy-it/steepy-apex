{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "artifact", "signals"],
  "properties": {
    "status": { "enum": ["APPROVED", "ISSUES_FOUND", "BLOCKED", "NEEDS_CONTEXT"] },
    "artifact": { "type": "string", "minLength": 1 },
    "signals": { "type": "string", "minLength": 1 }
  }
}
